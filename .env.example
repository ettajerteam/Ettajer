# Database — pooler for runtime (Vercel/serverless); direct for `prisma db push`
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Public app origin (available on server + client). Keep in sync with NEXTAUTH_URL for local.
# Used for absolute store links in the dashboard to avoid hydration mismatches.
# Production MUST be https://www.ettajer.com (never localhost) — emails and magic links use this.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (also powers Google One Tap on the homepage / login)
# In Google Cloud Console → Credentials → OAuth 2.0 Client:
#   Authorized JavaScript origins: http://localhost:3000 and https://www.ettajer.com
#   Authorized redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta / Facebook Login for Business (Marketing → Meta → Connect with Meta)
# Docs: https://developers.facebook.com/docs/facebook-login/facebook-login-for-business
# Valid OAuth Redirect URIs (add BOTH in Meta App Dashboard):
#   http://localhost:3000/api/marketing/meta/oauth/callback
#   https://www.ettajer.com/api/marketing/meta/oauth/callback
# Data deletion (App settings → User data deletion):
#   Callback: https://www.ettajer.com/api/meta/data-deletion
#   Instructions: https://www.ettajer.com/data-deletion
# Create a Login for Business configuration (permissions live in the config, not in scope=)
META_APP_ID=""
META_APP_SECRET=""
META_LOGIN_CONFIG_ID=""
# Optional override (defaults to local/production callback derived from the request)
# META_OAUTH_REDIRECT_URI="https://www.ettajer.com/api/marketing/meta/oauth/callback"
# META_GRAPH_VERSION="v21.0"

# Pinterest OAuth (Marketing → Pinterest → Connect with Pinterest)
# Docs: https://developers.pinterest.com/docs/getting-started/set-up-authentication-and-authorization/
# Register app at https://developers.pinterest.com/ — add BOTH redirect URIs:
#   http://localhost:3000/api/marketing/pinterest/oauth/callback
#   https://www.ettajer.com/api/marketing/pinterest/oauth/callback
# Scopes used: ads:read, catalogs:read (Tag + ad account picker).
# Conversions API still needs an Ads Manager Conversion access token (Advanced tab).
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
# Optional override (defaults to local/production callback derived from the request)
# PINTEREST_OAUTH_REDIRECT_URI="https://www.ettajer.com/api/marketing/pinterest/oauth/callback"

# Cron jobs (Vercel Cron sends Authorization: Bearer CRON_SECRET)
# Required for Marketing → Meta → Audiences → Daily auto re-sync
CRON_SECRET=""

# Resend (https://resend.com) — domain ettajer.com verified
RESEND_API_KEY="re_xxxxxxxxx"

# Sender for transactional mail (login links, password reset, order emails)
EMAIL_FROM="Ettajer <noreply@ettajer.com>"

# Inbox for contact form submissions
SUPPORT_EMAIL="support@ettajer.com"

# Platform admin emails (comma-separated). Default owner: ettajerteam@gmail.com
ADMIN_EMAILS="ettajerteam@gmail.com"

# Google Cloud ops (service account — secrets/ettajer-ops.json)
GCP_PROJECT_ID="ettajer-501512"
GOOGLE_APPLICATION_CREDENTIALS="./secrets/ettajer-ops.json"
ETTAJER_OPS_SA="ettajer-ops@ettajer-501512.iam.gserviceaccount.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXX"
# Google Tag Manager container (platform site). Default: GTM-WZ7QXGGP
NEXT_PUBLIC_GTM_ID="GTM-WZ7QXGGP"
# GA4_PROPERTY_ID="123456789"
SEARCH_CONSOLE_SITE_URL="sc-domain:ettajer.com"
# Public launch datetime (ISO). Default: 2026-07-23 Casablanca midnight.
ETTAJER_LAUNCH_TARGET="2026-07-23T00:00:00.000+01:00"
# Platform readiness (90–94). Floor is 90 so early-access always shows Beta testing now.
NEXT_PUBLIC_ETTAJER_LAUNCH_PROGRESS="90"
ETTAJER_LAUNCH_PROGRESS="90"

# Uploadthing (https://uploadthing.com) — optional client uploads
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""
# Client flag so the product image UI prefers UploadThing when set
NEXT_PUBLIC_UPLOADTHING_APP_ID=""

# Vercel Blob — required for product/logo uploads on Vercel (serverless has no writable /public)
# Create in Vercel → Storage → Blob, then copy the read/write token
BLOB_READ_WRITE_TOKEN=""

# Optional: RapidAPI key for full AliExpress dropship import (title, price, gallery)
# Without it, Ettajer still tries HTML/meta/Jina — AliExpress often blocks those.
# RAPIDAPI_KEY=""
# RAPIDAPI_ALIEXPRESS_HOST="aliexpress-datahub.p.rapidapi.com"

# Public site URL for SEO (sitemap, Open Graph, canonical URLs)
# Production: https://ettajer.com
# Local: can stay as production — getSiteUrl() uses NEXT_PUBLIC_APP_URL / localhost in development
NEXT_PUBLIC_SITE_URL="https://ettajer.com"

# Custom domain DNS targets shown to merchants (Vercel defaults)
# NEXT_PUBLIC_DOMAIN_CNAME_TARGET="cname.vercel-dns.com"
# NEXT_PUBLIC_DOMAIN_A_TARGET="76.76.21.21"

# Vercel Domains API — required for merchant custom domains (SSL + routing)
# Create a token: https://vercel.com/account/tokens
# Project ID: Vercel → Project → Settings → General
# Team ID: Vercel → Team Settings → General (if using a team)
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""

# Namecheap domain reseller API (sell/register domains on Ettajer)
# 1) Enable API: Namecheap → Profile → Tools → Namecheap API Access
# 2) Whitelist the public IPv4 of the machine that calls the API (IPv4 only)
# 3) ClientIp below MUST equal that whitelisted IP
# NOTE: Vercel serverless has rotating outbound IPs — use a static-IP VPS/proxy for production.
# NAMECHEAP_API_USER="your_namecheap_username"
# NAMECHEAP_API_KEY=""
# NAMECHEAP_USERNAME="your_namecheap_username"
# NAMECHEAP_CLIENT_IP="000.000.000.000"
# NAMECHEAP_SANDBOX="1"

# Cron auth for /api/cron/* (email queue every minute; Atlas hourly)
# CRON_SECRET="generate-a-long-random-string"

# Optional OpenAI for Email Marketing Atlas copilot / flow copy (rules engine used if unset)
# OPENAI_API_KEY=""

# MailHub — encrypt merchant ESP/SMTP secrets at rest (falls back to NEXTAUTH_SECRET)
# EMAIL_SECRETS_KEY="generate-a-long-random-string"

# Active platform ESP when merchants use Ettajer Managed (default prefers Resend)
# EMAIL_PROVIDER="resend"
# POSTMARK_SERVER_TOKEN=""
# SENDGRID_API_KEY=""
# SES_ACCESS_KEY_ID="" / AWS_ACCESS_KEY_ID
# SES_SECRET_ACCESS_KEY="" / AWS_SECRET_ACCESS_KEY
# SES_REGION="eu-west-1"

# Email provider webhooks (opens/clicks/bounces) — POST /api/webhooks/email/resend
# RESEND_WEBHOOK_SECRET="whsec_..."
# Optional fallback for any provider adapter:
# EMAIL_WEBHOOK_SECRET=""

# ─── Payments (Stripe Connect — merchant owns card money) ───
# Platform secret key from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret for /api/webhooks/stripe
# Subscribe to: account.updated, account.application.deauthorized, checkout.session.completed
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional publishable key (Checkout redirect uses server sessions today)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Developer Platform (OAuth / API)
# Client-secret encryption reuses EMAIL_SECRETS_KEY (preferred) or NEXTAUTH_SECRET.
# Do not put secrets in NEXT_PUBLIC_* variables.
# Optional dedicated key only if you must isolate developer crypto from mail:
# DEVELOPER_SECRETS_KEY=""
# (Currently unused — set EMAIL_SECRETS_KEY or NEXTAUTH_SECRET instead.)

# Theme preview token signing (short-lived, purpose=theme_preview only).
# Falls back to NEXTAUTH_SECRET or EMAIL_SECRETS_KEY.
# PREVIEW_TOKEN_SECRET=""

# Rate limiting backend: memory (default, local/single-instance) or redis (multi-instance).
# RATE_LIMIT_BACKEND=memory
# For RATE_LIMIT_BACKEND=redis, set Upstash REST credentials:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# In-memory rate limiting is NOT safe across multiple production instances.
